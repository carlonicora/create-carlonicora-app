  "name": "{{name}}-api",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nodemon --watch src --watch ../../packages/nestjs-neo4jsonapi/src --ext ts --exec \"ts-node -r tsconfig-paths/register src/main.ts --mode=api\"",
    "dev:worker": "nodemon --watch src --watch ../../packages/nestjs-neo4jsonapi/src --ext ts --exec \"ts-node -r tsconfig-paths/register src/main.ts --mode=worker\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "start": "nest start --mode=api",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nodemon --watch src --watch ../../packages/nestjs-neo4jsonapi/src --ext ts --exec \"ts-node -r tsconfig-paths/register src/main.ts --mode=api\"",
    "start:prod": "node --max-old-space-size=6144 dist/main --mode=api",
    "start:worker": "nest start --mode=worker",
    "start:worker:dev": "nodemon --watch src --watch ../../packages/nestjs-neo4jsonapi/src --ext ts --exec \"ts-node -r tsconfig-paths/register src/main.ts --mode=worker\"",
    "start:worker:prod": "node --max-old-space-size=6144 dist/main --mode=worker",
    "build-module-id-map": "ts-node --transpile-only -r tsconfig-paths/register scripts/build-module-id-map.ts",
    "rbac:dump": "ts-node --transpile-only -r tsconfig-paths/register scripts/rbac-dump.ts",
    "generate:rbac-paths": "pnpm build-module-id-map && node ../../packages/nestjs-neo4jsonapi/dist/tools/generate-rbac-paths/index.js --dir dist/features --output src/features/rbac/module-relationships.map.ts --module-id-map src/rbac/module-id.map.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk",
    "test:e2e": "vitest run --config ./vitest.e2e.config.ts",
    "test:e2e:debug": "vitest --config ./vitest.e2e.config.ts",
    "test:watch": "vitest"
  },
  "version": "1.0.0"
