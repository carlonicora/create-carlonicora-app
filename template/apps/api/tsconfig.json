{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "target": "ES2021",
    "outDir": "./dist",
    "incremental": true,
    "importHelpers": true,
    // Override strict settings for API (keeping existing behavior)
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "paths": {
      // `moduleResolution: nodenext` honours each package's "exports" map, so the
      // deep-subpath mappings that node10 needed (@langchain/*) are gone — the
      // public entry points those imports use are declared exports, and the
      // ambient shim in src/types/langchain.d.ts covers the rest.
      // Targets are relative to this file: TypeScript 6 removed `baseUrl`.
      "src/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "templates"],
  "exclude": ["dist", "node_modules"]
}
