# =============================================================================
# ENVIRONMENT VARIABLE REFERENCE
# =============================================================================
#
# SERVICE REQUIREMENTS FOR STANDALONE DEPLOYMENT:
# -----------------------------------------------
# When deploying services independently (docker-compose.api.yml, etc.),
# each service requires different environment variables:
#
# API SERVICE (docker-compose.api.yml):
#   Required: NEO4J_*, REDIS_*, S3_*, JWT_SECRET, API_URL, API_PORT
#   Optional: AI_*, EMBEDDER_*, TRANSCRIBER_*, CORS_*, RATE_LIMIT_*, CACHE_*
#
# WORKER SERVICE (docker-compose.worker.yml):
#   Required: NEO4J_*, REDIS_*, S3_*, JWT_SECRET
#   Optional: AI_*, EMBEDDER_*, TRANSCRIBER_*, EMAIL_*
#   Note: Workers process background jobs and don't serve HTTP traffic
#
# WEB SERVICE (docker-compose.web.yml):
#   Required: API_URL, API_INTERNAL_URL, PORT, NEXT_PUBLIC_API_URL, NEXT_PUBLIC_ADDRESS
#   Build-time: NEXT_PUBLIC_* variables are embedded during build (rebuild needed if changed)
#   Note: Set API_INTERNAL_URL to public API URL when deploying standalone
#
# ALL SERVICES (docker-compose.yml):
#   All variables are loaded via YAML anchors
#
# =============================================================================

# =============================================================================
# API CONFIGURATION (API)
# =============================================================================
API_URL="http://api.{{name}}.test:3950/"
API_PORT=3950
API_NODE_OPTIONS="--max-old-space-size=6144"
WORKER_NODE_OPTIONS="--max-old-space-size=6144"

# =============================================================================
# WEB APP CONFIGURATION (WEB)
# =============================================================================
APP_URL="http://{{name}}.test:3951/"
NEXT_PUBLIC_API_URL="http://api.{{name}}.test:3950/"
NEXT_PUBLIC_ADDRESS="http://{{name}}.test:3951"
PORT=3951
WEB_NODE_OPTIONS="--max-old-space-size=4096"

# =============================================================================
# LOGGING
# =============================================================================
CONSOLE_ENABLED=true

# =============================================================================
# DATABASE - NEO4J (API)
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE={{name}}

# =============================================================================
# CACHE & QUEUE - REDIS (API)
# =============================================================================
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_QUEUE={{name}}

# =============================================================================
# CACHE CONFIGURATION (API)
# =============================================================================
CACHE_ENABLED=false
CACHE_DEFAULT_TTL=600
CACHE_SKIP_PATTERNS=""

# =============================================================================
# AUTHENTICATION - JWT (API)
# =============================================================================
JWT_SECRET="{{name}}_SECRET"
JWT_EXPIRES_IN="1d"

# =============================================================================
# REGISTRATION CONTROL (API & WEB)
# =============================================================================
# Set to "false" to disable new user registration (email/password and social login)
NEXT_PUBLIC_ALLOW_REGISTRATION=true
ALLOW_REGISTRATION=true

# Registration mode: "open" (normal), "closed" (disabled), "waitlist" (requires invite)
NEXT_PUBLIC_REGISTRATION_MODE=open

# =============================================================================
# WEB PUSH - VAPID (API & WEB)
# =============================================================================
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL=""

# Web-specific VAPID public key (for client-side use)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# =============================================================================
# EMAIL CONFIGURATION (API)
# =============================================================================
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# =============================================================================
# LOGGING - LOKI (API)
# =============================================================================
LOKI_ENABLED=true
LOKI_HOST=http://api.{{name}}.test:3100
# LOKI_USERNAME=your_username
# LOKI_PASSWORD=your_password
LOKI_APP_LABEL={{name}}-api

# =============================================================================
# TRACING - TEMPO (API)
# =============================================================================
TEMPO_ENABLED=true
TEMPO_ENDPOINT=http://localhost:4318/v1/traces
TEMPO_SERVICE_NAME={{name}}-api
TEMPO_SERVICE_VERSION=1.0.0

# =============================================================================
# OBJECT STORAGE - S3 / MINIO (API)
# =============================================================================
S3_TYPE="minio"
S3_ENDPOINT="http://minio.{{name}}.test:9000/"
S3_BUCKET="{{name}}"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_REGION=""

# =============================================================================
# RATE LIMITING / THROTTLER (API)
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL=60000
RATE_LIMIT_REQUESTS=1000
IP_RATE_LIMIT_REQUESTS=200

# =============================================================================
# CORS CONFIGURATION (API)
# =============================================================================
CORS_ORIGINS=http://{{name}}.test:3951
CORS_ORIGIN_PATTERNS=
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,x-language,x-companyid
CORS_MAX_AGE=86400
CORS_PREFLIGHT_CONTINUE=false
CORS_OPTIONS_SUCCESS_STATUS=204
CORS_LOG_VIOLATIONS=false

# =============================================================================
# IMAGE SOURCES (WEB)
# =============================================================================
IMAGE_SOURCES=http://localhost:9000,http://host.docker.internal:9000,http://minio.{{name}}.test:9000

# =============================================================================
# AI
# =============================================================================
# Supported providers: llamacpp, openrouter, vertex
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_URL=
AI_REGION=
AI_SECRET=
AI_INSTANCE=
AI_API_VERSION=
AI_INPUT_COST_PER_1M_TOKENS=0.1
AI_OUTPUT_COST_PER_1M_TOKENS=0.4
# Google Vertex AI: Base64-encoded GCP service account JSON (for AI_PROVIDER=vertex)
AI_GOOGLE_CREDENTIALS_BASE64=""

# =============================================================================
# VISION AI (optional - falls back to AI_* if not set)
# =============================================================================
# Use these to configure a different model/provider for vision tasks
VISION_PROVIDER=
VISION_API_KEY=
VISION_MODEL=
VISION_URL=
VISION_REGION=
VISION_SECRET=
VISION_INSTANCE=
VISION_API_VERSION=
VISION_INPUT_COST_PER_1M_TOKENS=
VISION_OUTPUT_COST_PER_1M_TOKENS=
VISION_GOOGLE_CREDENTIALS_BASE64=

# =============================================================================
# EMBEDDER (API)
# =============================================================================
# Supported providers: openai, openrouter, azure, vertex
EMBEDDER_PROVIDER=
EMBEDDER_API_KEY=
EMBEDDER_MODEL=
EMBEDDER_URL=
EMBEDDER_INSTANCE=
EMBEDDER_API_VERSION=
EMBEDDER_DIMENSIONS=3072
# Google Vertex AI: GCP region for embeddings (e.g., us-central1, europe-west1)
EMBEDDER_REGION=""
# Google Vertex AI: Base64-encoded GCP service account JSON (for EMBEDDER_PROVIDER=vertex)
EMBEDDER_GOOGLE_CREDENTIALS_BASE64=""

# =============================================================================
# TRANSCRIBER (API)
# =============================================================================
# Supported providers: openai, azure
TRANSCRIBER_PROVIDER=
TRANSCRIBER_API_KEY=
TRANSCRIBER_MODEL=
TRANSCRIBER_URL=
TRANSCRIBER_API_VERSION=

# =============================================================================
# DEBUG LOGGING (API)
# =============================================================================
DEBUG_LOGGING_ENABLED=false
DEBUG_LOG_PATH=./logs

# =============================================================================
# GOOGLE API KEYS (API & WEB)
# =============================================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# =============================================================================
# STRIPE CONFIGURATION (API & WEB)
# =============================================================================
# Stripe secret key for backend API (starts with sk_test_)
STRIPE_SECRET_KEY=""
# Stripe publishable key for frontend (starts with pk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Stripe webhook secret for verifying webhook signatures (starts with whsec_)
STRIPE_WEBHOOK_SECRET=""

# =============================================================================
# CLOUDFLARE TURNSTILE (API & WEB)
# =============================================================================
# Turnstile site key (public, used in frontend)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Turnstile secret key (private, used in backend verification)
TURNSTILE_SECRET_KEY=""
# Dev/Test keys (always pass): Site Key: 1x00000000000000000000AA, Secret Key: 1x0000000000000000000000000000000AA

# =============================================================================
# OAUTH - DISCORD (API & WEB)
# =============================================================================
# Get credentials from: https://discord.com/developers/applications
# Add authorized redirect URI: {API_URL}/auth/callback/discord
# Client ID enables login button on frontend AND is used by backend for OAuth flow
NEXT_PUBLIC_DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# =============================================================================
# OAUTH - GOOGLE (API & WEB)
# =============================================================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application)
# Add authorized redirect URI: {API_URL}/auth/callback/google
# Client ID enables login button on frontend AND is used by backend for OAuth flow
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# 2FA / TWO-FACTOR AUTHENTICATION (API)
# =============================================================================
# TOTP encryption key - 64-character hex string (32 bytes) for AES-256-GCM
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# WebAuthn / Passkey configuration
# RP ID should match your domain (e.g., "example.com" for production, "localhost" for dev)
WEBAUTHN_RP_ID=localhost
# Display name shown in browser passkey dialogs
WEBAUTHN_RP_NAME={{name}}
# Origin for WebAuthn verification (must match your frontend URL exactly)
WEBAUTHN_ORIGIN=http://{{name}}.test:3951
# TTL in seconds for pending 2FA challenges (default: 300 = 5 minutes)
TWO_FACTOR_PENDING_TTL=300