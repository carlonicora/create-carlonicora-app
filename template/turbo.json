{
  "$schema": "https://turbo.build/schema.json",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "10GB",
  "globalDependencies": [
    "**/.env.*local",
    ".env",
    ".env.e2e"
  ],
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "API_PORT",
    "API_URL",
    "NEXT_PUBLIC_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "dev:worker": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "start:prod": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "start:worker:dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "env": [
        "NODE_ENV"
      ],
      "cache": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "NODE_ENV",
        "PORT",
        "E2E_*",
        "NEO4J_URI",
        "NEO4J_USER",
        "NEO4J_PASSWORD",
        "PUBLIC_HOSTNAME"
      ],
      "cache": false
    },
    "test:cov": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "env": [
        "NODE_ENV"
      ],
      "cache": true
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "*.tsbuildinfo"
      ],
      "cache": true
    },
    "{{name}}-web#build": {
      "dependsOn": [
        "^build",
        "@carlonicora/nextjs-jsonapi#build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_*"
      ]
    }
  }
}
