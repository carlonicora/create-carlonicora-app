# =============================================================================
# END-TO-END TEST ENVIRONMENT
# =============================================================================
#
# Copy to `.env.e2e` at the repo root and edit only what you need:
#
#   cp env.e2e.example .env.e2e
#
# `scripts/e2e.sh` sources this file (exporting everything it declares) BEFORE
# it boots anything, so any value here overrides the built-in default. It is
# also listed in turbo.json `globalDependencies`, so changing it busts the
# turbo cache. `.env.e2e` is gitignored — never commit it.
#
# EVERY variable `scripts/e2e.sh` reads is listed below. The stack it boots is
# deliberately disjoint from the dev stack: different ports, a different Neo4j
# database, a different Redis queue prefix, a different Next.js build directory.
# Leave it that way — the two stacks run at the same time on this machine.
#
# PREREQUISITES (not variables): Neo4j and Redis running locally, and
# /etc/hosts entries pointing PUBLIC_HOSTNAME and api.PUBLIC_HOSTNAME at
# 127.0.0.1.

# =============================================================================
# PORTS
# =============================================================================
# Dedicated to the e2e stack. They must not collide with the dev stack
# (API_PORT / PORT in .env) or with any other project on this machine.
E2E_API_PORT=4080
E2E_WEB_PORT=4081
# Reserved and freed on teardown. It is only listened on when the app opts in
# with bootstrap({ worker: { healthCheckPort: ... } }); the template does not,
# and the runner does not poll it — the migration check is the real readiness
# signal for the worker.
E2E_WORKER_HEALTH_PORT=4082

# =============================================================================
# DATABASE
# =============================================================================
# Dropped and recreated EMPTY at the start of every run, then filled by the
# worker's migrator. Never point this at a database you care about.
E2E_NEO4J_DATABASE={{name}}test
#
# Connection details are NOT duplicated here: `tests/scripts/e2e-db.mjs` and
# `tests/support/db.ts` read NEO4J_URI, NEO4J_USER and NEO4J_PASSWORD from the
# root `.env`, so the suite always talks to the same server the app does.
# Uncomment to point the suite at a different server than the dev stack uses.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# =============================================================================
# QUEUES
# =============================================================================
# BullMQ key prefix. MUST differ from the dev stack's REDIS_QUEUE in `.env`.
# Redis is a single shared instance, also used by other projects on this
# machine: with a shared prefix the e2e worker and the dev worker consume the
# SAME queues, and a job enqueued by one stack is executed by the other against
# the other stack's database.
E2E_REDIS_QUEUE={{name}}e2e

# =============================================================================
# HOSTS
# =============================================================================
# Read from the root `.env` by default. The runner derives the web host from it
# directly and the api host as "api.<PUBLIC_HOSTNAME>". Both must resolve to
# 127.0.0.1 in /etc/hosts. Override only if the e2e stack should answer on a
# different name than the dev stack.
# PUBLIC_HOSTNAME={{name}}.test

# =============================================================================
# SEEDED ADMINISTRATOR
# =============================================================================
# The platform administrator seeded by migration 20250901_004, which the
# Playwright `setup` project logs in as. Change these ONLY if you changed that
# migration — the e-mail must match the seeded node, and the password must be
# the plaintext of the bcrypt hash the migration stores.
# E2E_ADMIN_EMAIL=admin@{{name}}.com
# E2E_ADMIN_PASSWORD=password

# =============================================================================
# SET BY THE RUNNER — documented, not configured
# =============================================================================
# `scripts/e2e.sh` exports these into the child processes itself. They are
# listed so the stack's behaviour is discoverable from one file; setting them
# here has no effect on the processes the runner starts.
#
#   NEO4J_DATABASE            = E2E_NEO4J_DATABASE (api + worker)
#   REDIS_QUEUE               = E2E_REDIS_QUEUE (api + worker)
#   API_PORT / PORT           = E2E_API_PORT (api), E2E_WEB_PORT (web)
#   API_URL / API_INTERNAL_URL / NEXT_PUBLIC_API_URL
#                             = http://api.<PUBLIC_HOSTNAME>:<E2E_API_PORT>/
#   APP_URL / NEXT_PUBLIC_ADDRESS
#                             = http://<PUBLIC_HOSTNAME>:<E2E_WEB_PORT>
#   CORS_ORIGINS              = the web host AND http://localhost:<E2E_WEB_PORT>
#                               (navigator.serviceWorker needs a secure context,
#                               which a custom /etc/hosts name over plain http
#                               is not, so PWA tests load via localhost)
#   RATE_LIMIT_ENABLED        = false (the login route's per-IP @Throttle cannot
#                               be raised by the global throttler config, and a
#                               suite that logs in repeatedly otherwise 429s)
#   E2E_BUILD                 = true (next.config.js then uses distDir
#                               ".next-e2e", so the e2e build never clobbers the
#                               dev server's .next)
#   E2E_INSECURE_COOKIES      = true (for apps whose auth cookies honour it; the
#                               suite itself plants cookies through Playwright
#                               and does not depend on it)
