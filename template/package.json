{
  "name": "{{name}}",
  "version": "1.39.0",
  "private": true,
  "description": "",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:reset": "bash scripts/dev-reset.sh",
    "dev:api": "turbo run dev --filter={{name}}-api",
    "dev:web": "turbo run dev --filter={{name}}-web",
    "dev:worker": "turbo run start:worker:dev --filter={{name}}-api",
    "build": "turbo run build",
    "build:api": "turbo run build --filter={{name}}-api",
    "build:web": "turbo run build --filter={{name}}-web",
    "start": "turbo run start",
    "start:prod": "turbo run start:prod",
    "test": "turbo run test",
    "test:verbose": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "bash scripts/e2e.sh",
    "test:e2e:api": "turbo run test:e2e",
    "test:cov": "turbo run test:cov",
    "lint": "turbo run lint && node scripts/check-dep-drift.js",
    "format": "turbo run format",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "clean:all": "pnpm clean && pnpm -r exec rm -rf node_modules dist .next .turbo",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "neo4jsonapi-migrate": "node ./packages/nestjs-neo4jsonapi/dist/tools/migrate-entity/index.js",
    "generate-module": "node ./packages/nestjs-neo4jsonapi/dist/scripts/generate-module/index.js",
    "generate-web-module": "node ./packages/nextjs-jsonapi/dist/scripts/generate-web-module/index.js",
    "check:drift": "node scripts/check-dep-drift.js"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "ts-morph": "^28.0.0",
    "ts-node": "catalog:",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3"
  }
}
