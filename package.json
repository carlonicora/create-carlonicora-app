{
  "name": "create-carlonicora-app",
  "version": "1.12.0",
  "description": "Create a NestJS + Next.js monorepo project with Neo4j and JSON:API",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "create-carlonicora-app": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "template"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test \"scripts/**/*.test.js\"",
    "compare:template": "node scripts/compare/index.js",
    "template:apply": "node scripts/compare/apply.js",
    "check:template": "node scripts/integrity/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "scaffold",
    "nestjs",
    "nextjs",
    "monorepo",
    "template",
    "neo4j",
    "jsonapi"
  ],
  "author": "Carlo Nicora",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlonicora/create-carlonicora-app"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.0",
    "ora": "^9.4.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^11.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "^25.0.8",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
